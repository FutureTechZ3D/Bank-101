{
  "name": "bank-101-backend",
  "version": "1.0.0",
  "description": "Backend API for BANK-101 Competitive Exam Preparation Platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "create-admin": "ts-node --transpile-only src/scripts/createAdmin.ts",
    "test": "node --require ts-node/register/transpile-only --test \"tests/**/*.test.ts\"",
    "dev:test-server": "node --require ts-node/register/transpile-only tests/devServer.ts",
    "test:pg": "node tests/run-pg.cjs",
    "import:bank": "ts-node --transpile-only src/scripts/importBank.ts",
    "pipeline:ingest": "ts-node --transpile-only src/scripts/runPipeline.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "pg-mem": "^3.0.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
