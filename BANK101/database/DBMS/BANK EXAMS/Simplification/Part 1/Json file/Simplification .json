[
    {
        "quiz_id": 1,
        "quiz_name": "Simplification Quiz 1",
        "questions": [
            {
                "question_id": 1,
                "question": "5004 ÷ 139 - 6 = ?",
                "options": {
                    "A": "24",
                    "B": "30",
                    "C": "36",
                    "D": "42",
                    "E": "None of these"
                },
                "correct_option": "B",
                "explanation": "Given expression = 5004/139 - 6 = 36 - 6 = 30. Hence, option B is correct."
            },
            {
                "question_id": 2,
                "question": "2 - [2 - {2 - 2(2 + 2)}] = ?",
                "options": {
                    "A": "-4",
                    "B": "4",
                    "C": "6",
                    "D": "-6",
                    "E": "None of these"
                },
                "correct_option": "D",
                "explanation": "Given expression = 2 - [2 - {2 - 2 * 4}] => 2 - [2 - {2 - 8}] => 2 - [2 - (-6)] => 2 - [2 + 6] => 2 - 8 = -6. Hence, option D is correct."
            },
            {
                "question_id": 3,
                "question": "3640 ÷ 14 × 16 + 340 = ?",
                "options": {
                    "A": "0.70",
                    "B": "3525",
                    "C": "4480",
                    "D": "9600",
                    "E": "None of these"
                },
                "correct_option": "E",
                "explanation": "Given expression: 3640 ÷ 14 × 16 + 340 = 260 × 16 + 340 => 4160 + 340 => 4500. Hence, option E is correct."
            },
            {
                "question_id": 4,
                "question": "100 × 10 - 100 + 2000 ÷ 100 = ?",
                "options": {
                    "A": "29",
                    "B": "920",
                    "C": "979",
                    "D": "1020",
                    "E": "None of these"
                },
                "correct_option": "B",
                "explanation": "Given expression = 100 × 10 - 100 + 20 => 1000 - 100 + 20 => 1020 - 100 => 920. Hence, option B (920) is correct."
            },
            {
                "question_id": 5,
                "question": "(4 + 4 × 18 - 6 - 8) / (123 × 6 - 146 × 5) = ?",
                "options": {
                    "A": "1",
                    "B": "2",
                    "C": "6.65",
                    "D": "7.75",
                    "E": "None of these"
                },
                "correct_option": "D",
                "explanation": "By applying BODMAS rule, we get Numerator = 4 + 72 - 6 - 8 = 62. Denominator = 738 - 730 = 8. Expression = 62 / 8 = 7.75. Hence, option D is correct."
            }
        ]
    },
    {
